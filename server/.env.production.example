NODE_ENV=production
PORT=4000
TRUST_PROXY=1

APP_ORIGINS=https://rent.clientdomain.com
CLIENT_ORIGIN=https://rent.clientdomain.com

DB_HOST=production-mysql-host
DB_PORT=3306
DB_USER=bloom_borrow_app
DB_PASSWORD=replace-with-a-strong-random-password
DB_NAME=bloom_borrow
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=

JWT_SECRET=replace-with-at-least-64-random-characters
CSRF_SECRET=replace-with-a-different-at-least-64-random-characters
JWT_EXPIRES_IN=2h

# Use only during first Admin creation, then remove:
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
