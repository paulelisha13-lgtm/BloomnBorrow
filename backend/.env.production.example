NODE_ENV=production
PORT=4000
TRUST_PROXY=1

APP_ORIGINS=https://rent.clientdomain.com
CLIENT_ORIGIN=https://rent.clientdomain.com

DB_HOST=production-mysql-host
DB_PORT=3306
DB_USER=bloom_borrow_app
DB_PASSWORD=replace-with-a-strong-random-password
DB_NAME=bloom_borrow
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=

JWT_SECRET=replace-with-at-least-64-random-characters
CSRF_SECRET=replace-with-a-different-at-least-64-random-characters
JWT_EXPIRES_IN=2h
BOOKING_LINK_SECRET=replace-with-a-third-different-at-least-64-random-characters
BOOKING_LINK_TTL_HOURS=168

# Audit log entries older than this many days are deleted daily (0 = keep forever).
AUDIT_RETENTION_DAYS=30

# Stored ID documents and payment proofs of finished bookings (completed,
# cancelled, rejected) are deleted after this many days; bookings and payments
# are kept. Notifications older than this many days are deleted. 0 = keep.
UPLOAD_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30

# SMTP account used for automatic booking-status emails, GCash instructions,
# payment-review decisions, and invoices. Defaults
# to Gmail's SMTP server (smtp.gmail.com:465) when SMTP_HOST/SMTP_PORT are unset,
# so a Gmail address + App Password works with just SMTP_USER/SMTP_PASS below.
# Requires 2-Step Verification on that Google account, then an App Password
# generated at https://myaccount.google.com/apppasswords — SMTP_PASS is that
# 16-character value, not the account's normal login password.
# To use a different provider (SendGrid, Amazon SES, a relay, ...) instead, set
# SMTP_HOST/SMTP_PORT/SMTP_SECURE to that provider's values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-the-sending-email-address
SMTP_PASS=replace-with-the-16-character-app-password
SMTP_FROM_NAME=Bloom&Borrow

# Render free blocks outbound SMTP. Set BREVO_API_KEY to send over HTTPS instead
# (BREVO_SENDER_EMAIL must be a sender verified in Brevo; defaults to SMTP_USER).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Use only during first Admin creation, then remove:
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# --- Free-tier hosting (Render + TiDB/Supabase) ---
# Render's free disk is wiped on restart, so store uploads in a PRIVATE
# Supabase Storage bucket. Leave these unset to keep using backend/uploads.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=bloom-uploads
# Requests pass through Vercel and then Render.
TRUST_PROXY=2
